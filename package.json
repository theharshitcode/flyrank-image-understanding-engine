{
  "name": "flyrank-capstone-imagerelevance",
  "version": "1.0.0",
  "private": false,
  "description": "AI image understanding and content matching engine with a confidence-aware mismatch guard.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/workers/worker.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node scripts/seed.js",
    "eval": "node scripts/evaluate.js",
    "test": "node --test",
    "check": "node --check src/server.js && node --test",
    "seed:images": "node scripts/seed-images.js",
    "match:all": "node scripts/queue-matches.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "openai": "^5.20.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {}
}
